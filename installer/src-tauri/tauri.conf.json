{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen RPC Setup",
  "mainBinaryName": "LumenRPC-Lite-Setup",
  "version": "0.1.0",
  "identifier": "xyz.lumenrpc.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lumen RPC Setup",
        "width": 560,
        "height": 400,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Oskar Trzaskawka",
    "copyright": "© 2026 Oskar Trzaskawka",
    "homepage": "https://github.com/OskarTrzaskawka/LumenRPC",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
